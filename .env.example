# OAuth client ID from Google Cloud Console → APIs & Services → Credentials
# (type "Web application", authorised JavaScript origin http://localhost:5173)
GOOGLE_CLIENT_ID=
# Any long random string: openssl rand -hex 32
JWT_SECRET=
# AI provider for the chat and document agents: gemini, anthropic or local.
# Unset: Gemini when GEMINI_API_KEY is set, otherwise Claude.
# LLM_PROVIDER=gemini

# Local model over an OpenAI-compatible API (LM Studio). Start its server reachable from Docker:
#   lms server start --port 1234 --bind 172.17.0.1
# LOCAL_LLM_URL=http://host.docker.internal:1234/v1
# LOCAL_LLM_MODEL=qwen3-4b-instruct-2507
# Chat agent model, if different (it needs good tool calling; e.g. a vision model for documents above
# and qwen3-4b-instruct-2507 here). Unset: LOCAL_LLM_MODEL.
# LOCAL_LLM_CHAT_MODEL=qwen3-4b-instruct-2507
# LOCAL_LLM_API_KEY=   (only if the server requires one)

# Google Gemini key: https://aistudio.google.com/apikey
# On the free tier Google may use what you send (including document scans) to improve its products.
# Use a paid key before real users upload documents.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash  (list what your key can use: see backend/README.md)

# Claude API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_EFFORT=high
# GUIDELINE_MAX_AGE_DAYS=90

# Google accounts (comma-separated emails) that can see the data pipeline admin page.
ADMIN_EMAILS=matveypisarev.edu@gmail.com

# ---- Production only (docker-compose.prod.yml) ----
# Public domain; Caddy gets HTTPS certificates for it. Add https://<DOMAIN> to the Google OAuth
# client's authorised JavaScript origins.
DOMAIN=
POSTGRES_PASSWORD=
# Object storage credentials (any long random strings)
S3_ACCESS_KEY=
S3_SECRET_KEY=
